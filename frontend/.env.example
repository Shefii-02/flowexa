# API Configuration
VITE_API_URL=https://flowexa-api.univexa.in/api/v1

# WA Chat (Project B — WAHA backend, unichatwa.univexa.in)
VITE_WA_CHAT_API_URL=https://unichatwa.univexa.in

# Environment
VITE_APP_ENV=development

# WhatsApp session status pill in the header: true = call /waha/sessions/health, false = no API call.
VITE_SESSION_HEALTH_ENABLED=true
# Poll interval in seconds (min 30). 0 = disabled.
# Server-side wa-chat:check-health (every 5 min) runs regardless.
VITE_SESSION_HEALTH_POLL_SECONDS=180

# Session Configuration
VITE_SESSION_TIMEOUT_MINUTES=60
VITE_SESSION_WARNING_MINUTES=5

VITE_REVERB_APP_KEY=mskhf739shfnc9274kfnd936
VITE_REVERB_HOST=localhost
VITE_REVERB_PORT=8080
VITE_REVERB_SCHEME=http

# Meta (Facebook) App ID — enables one-click "Continue with Facebook" on Instagram > Accounts
VITE_META_APP_ID=
VITE_META_WA_CONFIG_ID=1674172357713131
